{
	"name": "react-native-klistra-ui",
	"version": "1.0.0",
	"description": "Librairie de composants React Native avec thème light / dark",
	"author": "Clément Lauer",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Patriot5701/react-native-klistra-ui.git"
	},
	"homepage": "https://github.com/Patriot5701/react-native-klistra-ui#readme",
	"bugs": {
		"url": "https://github.com/Patriot5701/react-native-klistra-ui/issues"
	},
	"keywords": [
		"react-native",
		"ui",
		"components",
		"theme",
		"dark-mode"
	],
	"main": "index.ts",
	"react-native": "./src/index.ts",
	"types": "./lib/typescript/src/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./lib/typescript/src/index.d.ts",
			"react-native": "./src/index.ts",
			"import": "./lib/module/index.js",
			"require": "./lib/module/index.js",
			"default": "./lib/module/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"lib",
		"!**/__tests__",
		"!**/__fixtures__",
		"!**/__mocks__"
	],
	"scripts": {
		"prepare": "bob build",
		"build": "bob build",
		"typecheck": "tsc --noEmit",
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web"
	},
	"peerDependencies": {
		"@expo/vector-icons": "*",
		"react": "*",
		"react-native": "*",
		"react-native-reanimated": ">=4",
		"react-native-worklets": ">=0.10"
	},
	"devDependencies": {
		"@expo/vector-icons": "^15.1.1",
		"@types/react": "^19.0.0",
		"babel-preset-expo": "~57.0.0",
		"expo": "^57.0.10",
		"react": "^19.2.8",
		"react-native": "^0.86.2",
		"react-native-builder-bob": "^0.40.0",
		"react-native-reanimated": "4.5.1",
		"react-native-worklets": "0.10.1",
		"typescript": "^5.8.0"
	},
	"overrides": {
		"uuid": "^11.1.1"
	},
	"react-native-builder-bob": {
		"source": "src",
		"output": "lib",
		"targets": [
			[
				"module",
				{
					"esm": true
				}
			],
			"typescript"
		]
	},
	"dependencies": {
		"react-native-collapsible": "^1.6.2"
	}
}